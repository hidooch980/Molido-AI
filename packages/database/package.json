{
  "name": "@molido/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and typed database client for MOLIDO AI.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "format": "prisma format",
    "validate": "prisma validate",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@molido/security": "workspace:*",
    "@molido/types": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
