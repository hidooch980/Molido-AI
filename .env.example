# =============================================
# Molido AI — تنظیمات Docker Compose
# کپی کنید: cp .env.example .env
# ⚠️ در production همه رمزها را عوض کنید
# =============================================

# دیتابیس
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=molido_ai

# JWT — حتماً مقدار تصادفی و طولانی بگذارید (مثلاً: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# CORS — آدرس داشبورد وب
CORS_ORIGIN=http://localhost:3001

# آدرس API برای داشبورد وب
NEXT_PUBLIC_API_URL=http://localhost:3000

# هوش مصنوعی (اختیاری — بدون آن تحلیل‌های داخلی کامل کار می‌کنند)
#
# هر سرویسی که واسط سازگار با OpenAI بدهد کار می‌کند: OpenAI، سرویس‌های
# داخلی، یا مدل محلی روی همان شبکه (Ollama، vLLM، LM Studio).
# نمونهٔ مدل محلی:  AI_BASE_URL=http://192.168.1.10:11434/v1
#                   AI_MODEL=llama3.1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# پیامک کاوه‌نگار (اختیاری)
# ارائه‌دهندهٔ پیامک: kavenegar (پیش‌فرض) یا sms.ir
#
# ⚠️ پیش‌فرض عمداً کاوه‌نگار است تا نصب‌های موجود با به‌روزرسانی ناگهان
#    پیامک نفرستند.
SMS_PROVIDER=kavenegar

# ⚠️ فقط برای sms.ir: شناسهٔ قالبِ تأییدشدهٔ کدِ یک‌بارمصرف.
#
#    بیشترِ حساب‌های sms.ir فقط با قالب اجازهٔ ارسالِ کدِ ورود دارند؛
#    متنِ آزاد رد می‌شود یا در صف می‌ماند.  خالی گذاشتنش یعنی متنِ آزاد
#    از راهِ /send/bulk — برای پیامِ عمومی درست است، ولی کدِ ورود
#    احتمالاً به دستِ مشتری نمی‌رسد.
SMSIR_TEMPLATE_ID=
# نامِ پارامترِ کد در قالب (پیش‌فرض CODE)
SMSIR_TEMPLATE_PARAM=

SMS_API_KEY=
SMS_SENDER=10008663

# درگاه پرداخت زرین‌پال (اختیاری)
#
# ⚠️ بدونِ `ZARINPAL_MERCHANT_ID`، پرداختِ آنلاین خطای روشن می‌دهد و
#    سفارش با «پرداخت در محل» ثبت می‌شود — سامانه بالا می‌آید ولی
#    هیچ پرداختِ ساختگی‌ای موفق شمرده نمی‌شود.
ZARINPAL_MERCHANT_ID=
# روی `true`، درگاهِ آزمایشی صدا زده می‌شود و پولِ واقعی جابه‌جا نمی‌شود.
ZARINPAL_SANDBOX=false

# ⚠️ فقط برای **آزمون** — در تولید تهی بماند.
#
#    درگاهِ ساختگیِ `backend/test/lib/fake-zarinpal.py` را نشانه می‌رود
#    تا مسیرِ پول از سرِتاسر آزموده شود؛ به‌ویژه سنجهٔ کم‌پرداختی که
#    بدونش روی هیچ ماشینی اجرا نمی‌شد.
#
#    `ops/set-payment.sh` هنگام پیکربندیِ واقعی صریحاً تهی‌اش می‌کند —
#    ماندنِ یک نشانیِ آزمونی یعنی پرداختِ واقعی به سرورِ ساختگی می‌رود.
#    مقدارِ توسعه:  http://host.docker.internal:8899
ZARINPAL_BASE_URL=

# شرکتی که کاتالوگِ سایتِ معرفی و فروشگاه به آن تعلق دارد.
#
# ⚠️ در `docker-compose.yml` پاس می‌شد ولی اینجا مستند نبود.
#    نتیجه‌اش این بود که نصبِ تازه بدونش بالا می‌آمد و
#    `/api/site/modules` خطای ۵۰۳ می‌داد بی‌آنکه کسی بداند چرا.
SHOP_COMPANY_ID=seed-company

# نشانیِ مطلقِ سایت — برای بازگشت از درگاه و نقشهٔ سایت.
#
# ⚠️ بدونِ این، درگاه نمی‌داند کاربر را کجا برگرداند: پول کم می‌شود و
#    سفارش «در انتظار» می‌ماند.  نقشهٔ سایت هم خالی برمی‌گردد.
SITE_URL=

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_password
N8N_WEBHOOK_SECRET=change_me_webhook_secret

# ─────────────────────────── ورود با درگاه دولت ───────────────────────────
#
# ⚠️ این مقادیر را **سازمانِ ثبت‌شده** از درگاه می‌گیرد؛ ساختنی نیستند.
#
#    تا وقتی `GOV_SSO_CLIENT_ID` تهی باشد، دکمهٔ «ورود با درگاه دولت»
#    در صفحهٔ ورود نشان داده نمی‌شود و مسیرها خطای روشن می‌دهند.
#    بقیهٔ سامانه دست‌نخورده کار می‌کند.
#
# ⚠️ نشانی‌ها اینجا نمونه ندارند و نباید حدس زده شوند: مشخصاتِ دقیق
#    (نوعِ flow، نامِ scopeها، نامِ ادعاها) در مستنداتِ رسمیِ یکپارچگی
#    می‌آید.  نشانیِ اشتباه یعنی خطایی که فقط در تولید دیده می‌شود.
GOV_SSO_CLIENT_ID=
GOV_SSO_CLIENT_SECRET=
GOV_SSO_AUTHORIZE_URL=
GOV_SSO_TOKEN_URL=
GOV_SSO_USERINFO_URL=

# ⚠️ باید **دقیقاً** همان چیزی باشد که نزدِ درگاه ثبت شده.
#    یک اسلشِ اضافه هم یعنی رد شدنِ درخواست.
#    شکلش:  https://your-domain.ir/gov-sso/callback  (نشانیِ بک‌اند)
GOV_SSO_REDIRECT_URI=

# نامِ scopeها نزدِ هر ارائه‌دهنده فرق می‌کند.
GOV_SSO_SCOPE=openid profile
GOV_SSO_TIMEOUT_MS=15000

# ⚠️ نشانیِ عمومیِ **API** — بازگشتِ درگاه پرداخت به همین‌جا می‌آید.
#
#    با `SITE_URL` فرق دارد: آن نشانیِ سایت است، این نشانیِ بک‌اند.
#    اگر تهی بماند، درگاه کاربر را به `localhost:3000` برمی‌گرداند —
#    یعنی پول کسر می‌شود و سفارش برای همیشه `PENDING` می‌ماند.
#
#    شکلش:  https://your-domain.ir/api
API_PUBLIC_URL=

# سامانه شاهکار — تطبیق شماره موبایل با کد ملی
#
# ⚠️ شاهکار API عمومی ندارد: یا سازمان مستقیم از رگولاتوری مجوز دارد،
#    یا از واسطی (فینوتک، جیبیت، زیبال…) می‌گیرد.  شکل درخواست و پاسخ
#    هر کدام فرق دارد، پس از پیکربندی خوانده می‌شود نه از کد.
#
# ⚠️ بدون SHAHKAR_URL و SHAHKAR_TOKEN، هیچ مسیری بسته نمی‌شود و پاسخ
#    `simulated` برمی‌گردد — سامانه بی‌اعتبارنامه هم بالا می‌آید.
SHAHKAR_URL=
SHAHKAR_TOKEN=
SHAHKAR_PROVIDER=generic
SHAHKAR_METHOD=POST
SHAHKAR_AUTH_SCHEME=Bearer
SHAHKAR_FIELD_NID=nationalCode
SHAHKAR_FIELD_MOBILE=mobile
# مسیر نتیجه در پاسخ، به شکل a.b.c
SHAHKAR_PATH_MATCHED=result.matched
SHAHKAR_PATH_REFERENCE=result.trackId
SHAHKAR_TIMEOUT_MS=8000

# اعمال در مسیرها (کالابرگ، ثبت‌نام مشتری، پرونده مشتری).
# `false` یعنی فقط سرویس استعلام فعال باشد و هیچ مسیری بسته نشود.
SHAHKAR_ENFORCE=true

# ⚠️ سیاست هنگام **در دسترس نبودن** سرویس — نه هنگام «تطبیق ندارد».
#
#    block  = ثبت‌نام تا بازگشت سرویس متوقف می‌شود (پیش‌فرض)
#    allow  = ثبت‌نام ادامه می‌یابد و بعداً باید بررسی شود
#
#    پیش‌فرض بستن است چون این احراز هویت است و پیش‌فرض ناامن چیزی است
#    که کسی هرگز عوض نمی‌کند.  «تطبیق ندارد» در هر دو حالت رد است.
SHAHKAR_ON_ERROR=block

# --- فهرستِ مشترکِ بارکد --------------------------------------------
# هر کالایی که ثبت می‌شود به فهرستِ مشترک برمی‌گردد تا فروشگاهِ بعدی با
# اسکن بشناسدش.  این همیشه روشن است و تنظیمی نمی‌خواهد.
#
# ⚠️ منبعِ بیرونی (Open Food Facts) پیش‌فرض **خاموش** است.
#    سنجیده شد: بارکدِ ایرانیِ ۶۲۶… را ندارد و برای بارکدِ ناموجود ۱۰
#    ثانیه طول می‌کشد — یعنی صندوق‌دار پشتِ باجه منتظر می‌ماند تا
#    «پیدا نشد» بشنود.  فقط برای فروشگاهِ کالای **وارداتی** روشنش کنید.
CATALOG_REMOTE=false
CATALOG_TIMEOUT_MS=4000
CATALOG_OFF_URL=

# --- دیده‌بان -------------------------------------------------------
# شماره‌ای که در قطعیِ سامانه پیامک می‌گیرد.  خالی یعنی دیده‌بان فقط
# لاگ می‌نویسد و پیامکی نمی‌فرستد (روی سروری که هنوز کلیدِ پیامک
# ندارد باید بی‌صدا کار کند، نه اینکه هر پنج دقیقه خطا بریزد).
WATCHDOG_SMS_TO=

# --- زیردامنهٔ هر محصول ---------------------------------------------
# خالی گذاشتنشان مشکلی ندارد؛ compose پیش‌فرضِ `.invalid` می‌گذارد.
#
# ⚠️ اینجا خالی بگذارید، ولی در compose **هرگز** `${VAR:-}` ننویسید.
#    Caddy پیش‌فرضِ `{$VAR:x}` را برای متغیرِ **تهی** اعمال نمی‌کند —
#    فقط برای تعریف‌نشده.  متغیرِ تهی «بلوکِ بدون نشانی» می‌سازد و کلِ
#    پیکربندی را باطل می‌کند؛ یعنی سایت بالا نمی‌آید.  سنجیده شد، و
#    `backend/test/caddy.sh` نگهبانش است.
# ⚠️ دستورِ TLS زیردامنه‌ها.  پیش‌فرضش در compose `tls internal` است
#    و **برداشتنش زیردامنه را از دسترس خارج می‌کند**، نه اینکه فقط
#    هشدار بدهد: بلوکِ بدونِ دستورِ tls سراغ Let's Encrypt می‌رود،
#    چالش شکست می‌خورد (سرور از بیرون در دسترس نیست) و هیچ گواهی‌ای
#    صادر نمی‌شود.  سنجیده شد با Caddyِ واقعی؛ `caddy validate`
#    نمی‌گیردش چون پیکربندی معتبر است.
#    وقتی DNS-01 راه افتاد، خالی بگذارید تا گواهیِ واقعی گرفته شود.
# تعداد پراکسی‌های بینِ مشتری و برنامه — دقیقاً به تعدادِ پرش‌ها.
#   ۱ = فقط Caddy
#   ۲ = CDN (آروان‌کلاود) + Caddy
# ⚠️ کم بودنش یعنی همهٔ مشتری‌ها یک سطلِ نرخ مشترک دارند و یک نفر
#    ورودِ همه را می‌بندد.  زیاد بودنش یعنی هرکسی می‌تواند نشانی‌اش را
#    جعل کند و از سقف فرار کند.
TRUST_PROXY=1

MOLIDO_TLS_SUB=tls internal
MOLIDO_HOST_STORE=
MOLIDO_HOST_RESTO=
# کدام محصول روی نشانیِ پایه (آی‌پی) سرو شود: store یا resto
MOLIDO_EDGE_DEFAULT=store
