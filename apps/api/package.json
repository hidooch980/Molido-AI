{
  "name": "@molido/api",
  "version": "0.1.0",
  "private": true,
  "description": "MOLIDO AI backend API (NestJS + Fastify).",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
