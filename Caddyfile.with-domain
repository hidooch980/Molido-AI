# ⚠️ این فایل **استفاده نمی‌شود** — نسخهٔ آماده برای وقتی دامنه دارید.
#
# چرا جدا و نه در Caddyfile اصلی: بلوکِ `{$MOLIDO_HOST_PUBLIC}` وقتی
# متغیر خالی باشد به «بلوک بدون نشانی» تبدیل می‌شود و **کل پیکربندی
# را باطل می‌کند** — سایت بالا نمی‌آید.  یک بار همین اتفاق روی سرور
# زنده افتاد.  Caddy شرط ندارد که بشود بلوک را مشروط ساخت.
#
# ── پیش‌نیازی که فقط دامنه نیست ──
#
# سرور ۱۹۴.۵.۱۷۶.۱۴۰ از داخل ایران در دسترس است و از بیرون نه
# (پراکسی بیرونی: ۵۲۲ تایم‌اوت).  Let's Encrypt سرورهای اعتبارسنجی‌اش
# بیرون‌اند، پس چالش‌های `http-01` و `tls-alpn-01` هیچ‌وقت موفق
# نمی‌شوند — با دامنه یا بی‌دامنه.
#
# تنها راه: چالش **DNS-01**.  اتصال ورودی نمی‌خواهد؛ سرور فقط یک رکورد
# TXT می‌سازد که ارتباط خروجی است.  لازمه‌اش:
#   ۱. یک دامنه
#   ۲. ارائه‌دهندهٔ DNS با API (Cloudflare رایگان کافی است)
#   ۳. افزونهٔ DNS در تصویر Caddy: caddy-dns/cloudflare
#   ۴. در همین فایل:  tls { dns cloudflare {env.CF_API_TOKEN} }
#
# روش استفاده:
#   cp Caddyfile.with-domain Caddyfile
#   MOLIDO_HOST_PUBLIC=your-domain.com  در .env
#   docker compose ... up -d --force-recreate caddy
#
# ─────────────────────────────────────────────────────────────────

# Caddy — تنها دری که از اینترنت باز است.
#
# چرا reverse proxy و نه انتشار مستقیم پورت‌ها:
#   ۱. TLS.  بدون آن، رمز کاربر و توکن روی سیم متن ساده است.
#   ۲. یک مبدأ.  پنل و API از یک نشانی می‌آیند، پس CORS و کوکی ساده می‌شود.
#   ۳. دیتابیس، n8n و بک‌اند اصلاً روی اینترنت شنونده نیستند.
#
# {$MOLIDO_HOST} از محیط می‌آید:
#   دامنه  → Caddy خودش گواهی Let's Encrypt می‌گیرد.
#   آی‌پی   → گواهی خودامضا (`tls internal`)؛ مرورگر یک بار هشدار می‌دهد.
#            برای فروشگاه واقعی دامنه بگیرید — هشدار مرورگر را کاربر
#            یاد می‌گیرد نادیده بگیرد، و همان عادت خطرناک است.

{
	{$MOLIDO_ACME}

	# نشستِ بدون SNI به کدام سایت تعلق دارد.
	#
	# استاندارد TLS اجازه نمی‌دهد آی‌پی در SNI بیاید، پس وقتی نصب روی
	# آی‌پی است، مرورگر هیچ نامی نمی‌فرستد و Caddy نمی‌داند کدام گواهی را
	# ارائه کند — دست‌دادن با «internal error» می‌شکند و هیچ لاگ روشنی هم
	# نمی‌دهد.  با دامنه بی‌اثر است.
	default_sni {$MOLIDO_HOST}

	servers {
		trusted_proxies static private_ranges
	}
}

# ---------------------------------------------------------------
# محتوای سایت، یک بار.
#
# دو بلوکِ نشانی پایین هر دو همین را وارد می‌کنند.  نوشتنش دو بار،
# یعنی دو جا که دیر یا زود از هم واگرا می‌شوند.
# ---------------------------------------------------------------
(molido) {

	encode gzip zstd

	# ---------- API ----------
	# `handle_path` پیشوند /api را حذف می‌کند، چون بک‌اند مسیرهایش را از
	# ریشه سرو می‌کند (`/products` نه `/api/products`).
	handle_path /api/* {
		reverse_proxy backend:3000
	}

	# ---------- فایل‌های آپلودشده ----------
	handle /uploads/* {
		reverse_proxy backend:3000
	}

	# ---------- مستندات ----------
	handle /api-docs* {
		reverse_proxy backend:3000
	}

	# ---------- پنل و فروشگاه ----------
	handle {
		reverse_proxy web:3001
	}

	# n8n عمداً اینجا نیست.
	#
	# رابطش تمام‌اختیار است: هر کسی که واردش شود می‌تواند گردش‌کاری بسازد
	# که به API فروشگاه دستور بدهد.  از راه تونل SSH بازش کنید:
	#   ssh -L 5678:localhost:5678 root@SERVER
	# و بعد در مرورگر خودتان http://localhost:5678

	header {
		# مرورگر نگذارد صفحه در iframe سایت دیگری باز شود
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# درخواست‌های موفقِ فایل ثابت نویز است؛ فقط خطاها بمانند.
		level ERROR
	}
}

# ---------- نشانی آی‌پی ----------
#
# گواهی خودامضا.  Let's Encrypt برای آی‌پی گواهی نمی‌دهد.
#
# این بلوک عمداً می‌ماند حتی وقتی نامِ دارای گواهی هم هست: اگر صدور
# گواهی شکست بخورد، دسترسی از این راه قطع نمی‌شود.
{$MOLIDO_HOST} {
	{$MOLIDO_TLS}
	import molido
}

# ---------- نشانی دارای گواهی معتبر ----------
#
# `nip.io` هر نامی به شکل `1-2-3-4.nip.io` را به همان آی‌پی حل می‌کند.
# پس بدون خریدن دامنه هم می‌شود گواهی واقعی گرفت و هشدار مرورگر را
# برداشت — هشداری که کاربر یاد می‌گیرد نادیده بگیرد، و همان عادت
# خطرناک است.
#
# خالی بودن این متغیر یعنی بلوک ساخته نمی‌شود.
{$MOLIDO_HOST_PUBLIC} {
	import molido
}
