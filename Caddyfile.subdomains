# Caddy — یک لبه، چند زیردامنه، چند محصول.
#
# جایگزینِ `Caddyfile` وقتی هر محصول زیردامنهٔ خودش را دارد:
#
#   shop.example.ir   → فروشگاه   (پروژهٔ molido-store)
#   cafe.example.ir   → رستوران   (پروژهٔ molido-resto)
#   example.ir        → همان فروشگاه، یا هر کدام که پیش‌فرض است
#
# ⚠️ **متغیرِ خالی کلِ پیکربندی را باطل می‌کند** — و این یک بار روی
#    سرورِ زنده اتفاق افتاد.
#
#    `{$VAR} { ... }` وقتی `VAR` تهی باشد به «بلوکِ بدون نشانی»
#    تبدیل می‌شود، و Caddy آن را «پیکربندی سراسری» می‌فهمد که باید
#    اولین بلوک باشد.  خطایش (`server block without any key`) هیچ
#    اشاره‌ای به متغیرِ خالی ندارد و سایت بالا نمی‌آید.
#
#    راهِ حل: هر متغیر پیش‌فرضِ `.invalid` دارد.  دامنهٔ سطح‌بالای
#    `.invalid` طبق RFC 2606 هرگز واقعی نمی‌شود، پس بلوک ساخته
#    می‌شود، پیکربندی معتبر می‌ماند، و هیچ‌کس هرگز به آن نمی‌رسد.
#
# ⚠️ نام‌های `store-web` و `resto-web` از `aliases` شبکهٔ مشترک
#    می‌آیند، نه از نامِ سرویس.
#
#    هر دو پروژه سرویسی به نامِ `web` دارند؛ روی شبکهٔ مشترک، `web`
#    به یکی از آن دو حل می‌شود و کدام‌یک به ترتیبِ بالا آمدن بستگی
#    دارد.  یعنی زیردامنهٔ فروشگاه گاهی پنلِ رستوران را نشان می‌دهد
#    — بی‌آنکه چیزی خطا بدهد.  به `docker-compose.edge-caddy.yml` نگاه کنید.

{
	{$MOLIDO_ACME}

	# نشستِ بدون SNI به کدام سایت تعلق دارد.
	#
	# استاندارد TLS اجازه نمی‌دهد آی‌پی در SNI بیاید، پس وقتی نصب روی
	# آی‌پی است مرورگر هیچ نامی نمی‌فرستد و Caddy نمی‌داند کدام گواهی
	# را بدهد — دست‌دادن با «internal error» می‌شکند بی‌هیچ لاگِ روشنی.
	default_sni {$MOLIDO_HOST}

	servers {
		trusted_proxies static private_ranges
	}
}

# ---------------------------------------------------------------
# محتوای مشترک.  `{args[0]}` نامِ میزبانِ سرویس‌هاست.
#
# نوشتنش برای هر محصول جدا یعنی دو جا که دیر یا زود واگرا می‌شوند —
# و واگراییِ هدرهای امنیتی همان چیزی است که کسی متوجهش نمی‌شود.
# ---------------------------------------------------------------
(molido) {
	encode gzip zstd

	# `handle_path` پیشوند /api را حذف می‌کند، چون بک‌اند مسیرهایش را
	# از ریشه سرو می‌کند (`/products` نه `/api/products`).
	handle_path /api/* {
		reverse_proxy {args[0]}-backend:3000
	}

	handle /uploads/* {
		reverse_proxy {args[0]}-backend:3000
	}

	handle /api-docs* {
		reverse_proxy {args[0]}-backend:3000
	}

	handle {
		reverse_proxy {args[0]}-web:3001
	}

	# n8n عمداً اینجا نیست.
	#
	# رابطش تمام‌اختیار است: هر کسی که واردش شود می‌تواند گردش‌کاری
	# بسازد که به API فروشگاه دستور بدهد.  از راه تونل SSH بازش کنید:
	#   ssh -L 5678:localhost:5678 root@SERVER

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		level ERROR
	}
}

# ---------- نشانیِ پایه (آی‌پی یا دامنهٔ اصلی) ----------
#
# ⚠️ این بلوک حتی وقتی زیردامنه‌ها کار می‌کنند هم می‌ماند.
#
#    اگر صدور گواهی برای زیردامنه‌ها شکست بخورد — و روی این سرور
#    شکستنش محتمل است، پایینِ همین فایل را ببینید — دسترسی از راه
#    آی‌پی قطع نمی‌شود.  تنها راهِ ورود نباید چیزی باشد که به
#    اینترنتِ بیرون وابسته است.
{$MOLIDO_HOST} {
	{$MOLIDO_TLS}
	import molido {$MOLIDO_EDGE_DEFAULT:store}
}

# ---------- زیردامنهٔ فروشگاه ----------
#
# ⚠️ `{$MOLIDO_TLS_SUB}` **حذف نشود** — نبودش زیردامنه را کاملاً
#    از دسترس خارج می‌کند، نه اینکه فقط هشدار بدهد.
#
#    سنجیده شد، با Caddyِ واقعی: بلوکِ بدونِ دستورِ tls می‌رود سراغ
#    Let's Encrypt، چالش شکست می‌خورد (سرور از بیرون در دسترس نیست)،
#    و آن زیردامنه هیچ گواهی‌ای نمی‌گیرد — دست‌دادنِ TLS می‌شکند و
#    مرورگر اصلاً صفحه‌ای نشان نمی‌دهد.
#
#    `caddy validate` این را نمی‌گیرد: پیکربندی کاملاً معتبر است.
#    فقط اجرای واقعی نشانش می‌دهد.
#
#    پیش‌فرض `tls internal` است.  وقتی DNS-01 راه افتاد، خالی‌اش
#    کنید تا Caddy گواهیِ واقعی بگیرد:  MOLIDO_TLS_SUB=
{$MOLIDO_HOST_STORE:store.invalid} {
	{$MOLIDO_TLS_SUB}
	import molido store
}

# ---------- زیردامنهٔ رستوران/کافه ----------
{$MOLIDO_HOST_RESTO:resto.invalid} {
	{$MOLIDO_TLS_SUB}
	import molido resto
}

# ---------------------------------------------------------------
# ⚠️ گواهیِ Let's Encrypt روی این سرور با چالشِ معمول **کار نمی‌کند**.
#
#    سرور از داخل ایران در دسترس است و از بیرون نه.  سرورهای
#    اعتبارسنجیِ Let's Encrypt بیرون‌اند، پس `http-01` و `tls-alpn-01`
#    هرگز موفق نمی‌شوند — با دامنه یا بی‌دامنه، با زیردامنه یا بی‌آن.
#
#    تنها راه: چالشِ **DNS-01**.  اتصالِ ورودی نمی‌خواهد؛ سرور فقط یک
#    رکورد TXT می‌سازد که ارتباطِ خروجی است.  لازمه‌اش:
#      ۱. ارائه‌دهندهٔ DNS با API (Cloudflare رایگان کافی است)
#      ۲. افزونهٔ DNS در تصویرِ Caddy: `caddy-dns/cloudflare`
#         (تصویرِ رسمی ندارد؛ باید ساخته شود)
#      ۳. در بلوک‌های بالا:
#           tls { dns cloudflare {env.CF_API_TOKEN} }
#
#    تا آن وقت زیردامنه‌ها با `tls internal` کار می‌کنند: مرورگر یک
#    بار هشدار می‌دهد.  ⚠️ و همان هشدار خطرِ خودش را دارد — کاربر یاد
#    می‌گیرد نادیده‌اش بگیرد، و آن عادت روزی روی سایتِ جعلی هم تکرار
#    می‌شود.
# ---------------------------------------------------------------
