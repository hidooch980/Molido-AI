# =============================================
# Molido AI — تنظیمات Docker Compose
# کپی کنید: cp .env.example .env
# ⚠️ در production همه رمزها را عوض کنید
# =============================================

# دیتابیس
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=molido_ai

# JWT — حتماً مقدار تصادفی و طولانی بگذارید (مثلاً: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# CORS — آدرس داشبورد وب
CORS_ORIGIN=http://localhost:3001

# آدرس API برای داشبورد وب
NEXT_PUBLIC_API_URL=http://localhost:3000

# هوش مصنوعی (اختیاری — بدون آن تحلیل‌های داخلی کامل کار می‌کنند)
#
# هر سرویسی که واسط سازگار با OpenAI بدهد کار می‌کند: OpenAI، سرویس‌های
# داخلی، یا مدل محلی روی همان شبکه (Ollama، vLLM، LM Studio).
# نمونهٔ مدل محلی:  AI_BASE_URL=http://192.168.1.10:11434/v1
#                   AI_MODEL=llama3.1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# پیامک کاوه‌نگار (اختیاری)
SMS_API_KEY=
SMS_SENDER=10008663

# درگاه پرداخت زرین‌پال (اختیاری)
#
# ⚠️ بدونِ `ZARINPAL_MERCHANT_ID`، پرداختِ آنلاین خطای روشن می‌دهد و
#    سفارش با «پرداخت در محل» ثبت می‌شود — سامانه بالا می‌آید ولی
#    هیچ پرداختِ ساختگی‌ای موفق شمرده نمی‌شود.
ZARINPAL_MERCHANT_ID=
# روی `true`، درگاهِ آزمایشی صدا زده می‌شود و پولِ واقعی جابه‌جا نمی‌شود.
ZARINPAL_SANDBOX=false

# نشانیِ مطلقِ سایت — برای بازگشت از درگاه و نقشهٔ سایت.
#
# ⚠️ بدونِ این، درگاه نمی‌داند کاربر را کجا برگرداند: پول کم می‌شود و
#    سفارش «در انتظار» می‌ماند.  نقشهٔ سایت هم خالی برمی‌گردد.
SITE_URL=

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_password
N8N_WEBHOOK_SECRET=change_me_webhook_secret

# ─────────────────────────── ورود با درگاه دولت ───────────────────────────
#
# ⚠️ این مقادیر را **سازمانِ ثبت‌شده** از درگاه می‌گیرد؛ ساختنی نیستند.
#
#    تا وقتی `GOV_SSO_CLIENT_ID` تهی باشد، دکمهٔ «ورود با درگاه دولت»
#    در صفحهٔ ورود نشان داده نمی‌شود و مسیرها خطای روشن می‌دهند.
#    بقیهٔ سامانه دست‌نخورده کار می‌کند.
#
# ⚠️ نشانی‌ها اینجا نمونه ندارند و نباید حدس زده شوند: مشخصاتِ دقیق
#    (نوعِ flow، نامِ scopeها، نامِ ادعاها) در مستنداتِ رسمیِ یکپارچگی
#    می‌آید.  نشانیِ اشتباه یعنی خطایی که فقط در تولید دیده می‌شود.
GOV_SSO_CLIENT_ID=
GOV_SSO_CLIENT_SECRET=
GOV_SSO_AUTHORIZE_URL=
GOV_SSO_TOKEN_URL=
GOV_SSO_USERINFO_URL=

# ⚠️ باید **دقیقاً** همان چیزی باشد که نزدِ درگاه ثبت شده.
#    یک اسلشِ اضافه هم یعنی رد شدنِ درخواست.
#    شکلش:  https://your-domain.ir/gov-sso/callback  (نشانیِ بک‌اند)
GOV_SSO_REDIRECT_URI=

# نامِ scopeها نزدِ هر ارائه‌دهنده فرق می‌کند.
GOV_SSO_SCOPE=openid profile
GOV_SSO_TIMEOUT_MS=15000
