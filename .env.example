# =============================================
# Molido AI — تنظیمات Docker Compose
# کپی کنید: cp .env.example .env
# ⚠️ در production همه رمزها را عوض کنید
# =============================================

# دیتابیس
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=molido_ai

# JWT — حتماً مقدار تصادفی و طولانی بگذارید (مثلاً: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# CORS — آدرس داشبورد وب
CORS_ORIGIN=http://localhost:3001

# آدرس API برای داشبورد وب
NEXT_PUBLIC_API_URL=http://localhost:3000

# هوش مصنوعی (اختیاری — بدون آن تحلیل داخلی فعال است)
OPENAI_API_KEY=

# پیامک کاوه‌نگار (اختیاری)
SMS_API_KEY=
SMS_SENDER=10008663

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_password
N8N_WEBHOOK_SECRET=change_me_webhook_secret


# =====================================================================
# MOLIDO AI — MVP MONOREPO (apps/api, apps/web, packages/*)
# ---------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Generate strong secrets with:  openssl rand -hex 32
# =====================================================================

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- API (apps/api) ----------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Base path is fixed at /api and the version prefix is applied per-route: /api/v1
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Database (packages/database) --------------------------------------
# Matches infrastructure/docker/docker-compose.dev.yml defaults.
MVP_POSTGRES_USER=molido
MVP_POSTGRES_PASSWORD=molido_dev_password
MVP_POSTGRES_DB=molido_mvp
MVP_POSTGRES_PORT=5433
DATABASE_URL=postgresql://molido:molido_dev_password@localhost:5433/molido_mvp?schema=public

# --- Redis / queue -----------------------------------------------------
MVP_REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Authentication ----------------------------------------------------
# REQUIRED in every environment. Minimum 32 characters.
JWT_ACCESS_SECRET=
# Access tokens are short-lived; refresh tokens are opaque, hashed at rest,
# and rotated on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=molido-ai
JWT_AUDIENCE=molido-api
# Failed-login lockout policy.
MAX_FAILED_LOGINS=10
ACCOUNT_LOCK_MINUTES=15

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_LIMIT=10

# --- AI provider abstraction (Phase 6 — not enabled during Phase 1-5) ---
# Provider is selected at runtime; no key is hard-coded anywhere.
AI_PROVIDER=null
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# --- Web (apps/web) ----------------------------------------------------
# Public: exposed to the browser. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="MOLIDO AI"
